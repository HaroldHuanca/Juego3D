  modeloGerenteMonstruo: {fileID: 1743023353}
  puntoSalidaPuerta: {fileID: 1661369315}
  puntoExteriorFinal: {fileID: 1112839486}
  puntoJugadorFrenteGerente: {fileID: 2143472881}
  overlayCamaraRetro: {fileID: 124229624}
  sonidoBipCamara: {fileID: 8300000, guid: 8452854b75aa367478f574893e225895, type: 3}
  camaraPrincipal: {fileID: 1777399071}
  transformJugadorRaiz: {fileID: 646855850}
  scriptMovimientoJugador: {fileID: 646855853}
  scriptCamaraJugador: {fileID: 1777399073}
  textoIntroExterior: '23:45 PM - TIENDA 6TWELVE, CARRETERA NORTE

    Llegas a cubrir
    el turno nocturno...'
  dialogo1: 'Gerente: ''Buenas noches. Gracias por venir a cubrir el turno.'''
  dialogo2: "Gerente: 'Tu trabajo es simple: atiende a los clientes en la caja y
    mant\xE9n los anaqueles surtidos.'"
  dialogo3: "Gerente: 'Pero antes de comenzar, la empresa exige que te coloques la
    C\xC1MARA CORPORAL de seguridad.'"
  dialogo4: "Gerente: 'Excelente. Ahora est\xE1s grabando. Pase lo que pase... nunca
    apagues esa c\xE1mara.'"
  dialogo5: 'Gerente: ''Cierro la puerta al salir. Que tengas buena noche.'''
  pensamientoFinal: "T\xFA: '\xBFQu\xE9 demonios fue ese destello en la oscuridad...?
    Mejor me concentro en el turno.'"
  sonidoPensamientoFinal: {fileID: 0}
